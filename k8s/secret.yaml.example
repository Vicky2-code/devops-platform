# Example secret — real values go in a tool like `kubectl create secret` or
# an external secret manager. NEVER commit the real secret.
apiVersion: v1
kind: Secret
metadata:
  name: devflow-secrets
  namespace: devflow
type: Opaque
stringData:
  SECRET_KEY: "change-me"
  DATABASE_URL: "postgresql://devflow:devflow@postgres:5432/devflow"