#!/usr/bin/env bash
# ============================================================================
# devflow — Main CLI entrypoint
# DevOps Automation Platform (placeholder brand: devflow)
# ----------------------------------------------------------------------------
# Commands:
#   devflow init <name>       Scaffold a new project
#   devflow bootstrap         Interactive project scaffolding (legacy flow)
#   devflow doctor            Check environment prerequisites
#   devflow config <show|set> Print / set CLI configuration
#   devflow status            Show runtime status locally
#   devflow deploy <target>   Simulate a deployment (dev|staging|prod)
#   devflow version           Print version
#   devflow help              Show this help
# ============================================================================

set -o pipefail
# Do NOT use `set -e` globally: the dispatcher handles exit codes itself.

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PROJECT_ROOT="$(dirname "$SCRIPT_DIR")"

# ---- load shared libraries -------------------------------------------------
for _lib in colors common logging config; do
  # shellcheck source=lib/${_lib}.sh
  source "$SCRIPT_DIR/lib/${_lib}.sh"
done

VERSION="1.0.0"

usage() {
  cat <<'EOF'
devflow — DevOps Automation Platform CLI

USAGE:
  devflow <command> [options] [args]

COMMANDS:
  init <name>       Scaffold a new project structure + git repo
  bootstrap         Interactive project scaffolding (legacy)
  doctor            Check environment prerequisites
  config <op>       Show or set CLI configuration (show|set)
  status            Show runtime status of local services
  deploy <target>   Simulate a deployment (dev|staging|prod)
  version           Print version
  help              Show this help

EXAMPLES:
  devflow init my-project
  devflow doctor
  devflow config show
  devflow config set author "Vignesh"
  devflow deploy staging
EOF
}

# dispatch: load the command module then invoke its `main` function
run_command() {
  local cmd="$1"
  shift

  case "$cmd" in
    init)
      # shellcheck source=lib/commands/init.sh
      source "$SCRIPT_DIR/lib/commands/init.sh"
      main "$@"
      ;;
    bootstrap)
      # shellcheck source=lib/commands/bootstrap.sh
      source "$SCRIPT_DIR/lib/commands/bootstrap.sh"
      main "$@"
      ;;
    doctor)
      # shellcheck source=lib/commands/doctor.sh
      source "$SCRIPT_DIR/lib/commands/doctor.sh"
      main "$@"
      ;;
    config)
      # shellcheck source=lib/commands/config.sh
      source "$SCRIPT_DIR/lib/commands/config.sh"
      main "$@"
      ;;
    status)
      # shellcheck source=lib/commands/status.sh
      source "$SCRIPT_DIR/lib/commands/status.sh"
      main "$@"
      ;;
    deploy)
      # shellcheck source=lib/commands/deploy.sh
      source "$SCRIPT_DIR/lib/commands/deploy.sh"
      main "$@"
      ;;
    version)
      log_info "devflow version $VERSION"
      return 0
      ;;
    help|-h|--help)
      usage
      return 0
      ;;
    *)
      log_error "Unknown command: '$cmd'"
      usage
      return 1
      ;;
  esac
}

main() {
  if [[ $# -lt 1 ]]; then
    usage
    return 1
  fi
  run_command "$@"
}

main "$@"
exit $?